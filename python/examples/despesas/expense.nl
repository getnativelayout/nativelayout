<nativelayout>

<body>
    <div class="row">
        <div class="grow">
            <p class="title">{title}</p>
            <p class="muted">{category}</p>
        </div>
        <p class="amount">{amount}</p>
        <img id="remove" class="ibtn" src="icon:trash" alt="Apagar">
    </div>
</body>

</nativelayout>
